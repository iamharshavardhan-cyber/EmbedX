rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function userRole() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && userRole() in ['admin', 'super_admin'];
    }
    function isSuperAdmin() {
      return isSignedIn() && userRole() == 'super_admin';
    }
    function isScannerOrAdmin() {
      return isSignedIn() && userRole() in ['scanner', 'admin', 'super_admin'];
    }

    // Roles — only super_admin can write. Users can read their own role.
    match /roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Registrations — student owns their doc; admin full access
    match /registrations/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isScannerOrAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.registrationStatus == 'pending'
        && request.resource.data.ticketStatus == 'unissued';
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['paymentStatus', 'lastPaymentSubmittedAt', 'updatedAt'])
            && request.resource.data.paymentStatus in ['pending', 'submitted']);
      allow delete: if isSuperAdmin();

      // Payment attempts subcollection
      match /paymentAttempts/{attemptId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.status == 'submitted'
          && request.resource.data.keys().hasAll(['utr', 'screenshotRef', 'expectedAmount', 'status', 'submittedAt']);
        allow update, delete: if isAdmin();
      }
    }

    // Pins — claim once via transaction
    match /pins/{pinId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/pins/$(pinId));
      allow update, delete: if isSuperAdmin();
    }

    // Config (payment UPI etc.) — public read, admin write
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Used UTRs — prevent reuse
    match /usedUtrs/{utrId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
